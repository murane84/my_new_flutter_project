<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Biometric quick-unlock (local_auth) -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />

    <!-- Network -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_NETWORK_STATE" />

    <!-- Foreground service (audio playback) -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <!-- "Identify song" → "from this phone": capture the device's own audio
         output via MediaProjection playback capture (Android 10+). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />

    <!-- Media / storage -->
    <!-- Android 13+ (API 33+) granular media access -->
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" />
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission android:name="android.permission.READ_MEDIA_VIDEO" />

    <!-- Android 10–12 (API 29–32) -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <uses-permission
        android:name="android.permission.ACCESS_MEDIA_LOCATION"
        android:maxSdkVersion="32" />

    <!-- Android 9 and below (API 28-) -->
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />

    <!-- Notifications & system -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.ACCESS_NOTIFICATION_POLICY" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- Find-friends: read the address book to match contacts against
         registered Aluta users (auto-add matches as friends). -->
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <!-- "Connected apps": write Aluta's call/message rows onto matched contacts
         (like WhatsApp/Telegram) via a stub sync account. -->
    <uses-permission android:name="android.permission.WRITE_CONTACTS" />
    <uses-permission android:name="android.permission.READ_SYNC_SETTINGS" />
    <uses-permission android:name="android.permission.WRITE_SYNC_SETTINGS" />

    <!-- Attach sheet "Location": share the user's current location in chat.
         Requested at share time; coarse is enough for a shareable pin. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!-- Chat media sharing: voice-note recording + camera capture -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- WebRTC voice calls: audio routing + Bluetooth headset support. -->
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <uses-permission android:name="android.permission.BLUETOOTH" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <!-- Self-managed telecom: registers each Aluta call with the system so a
         car head-unit / Bluetooth device can answer & end it and route call
         audio over the hands-free profile (see AlutaConnectionService). -->
    <uses-permission android:name="android.permission.MANAGE_OWN_CALLS" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />

    <!-- FCM incoming-call notifications: show a full-screen ringing intent over
         the lock screen (Android 14+ requires this permission). -->
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />

    <!-- Let the user exempt Aluta from battery optimization so high-priority
         call pushes wake the app reliably (the "Call reliability" screen asks
         for this). Requesting the exemption dialog needs this permission. -->
    <uses-permission
        android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <application
        android:label="Aluta"
        android:name="${applicationName}"
        android:icon="@mipmap/launcher_icon"
        android:usesCleartextTraffic="true"
        android:networkSecurityConfig="@xml/network_security_config">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">

            <meta-data
                android:name="io.flutter.embedding.android.NormalTheme"
                android:resource="@style/NormalTheme" />

            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>

            <!-- Receive images shared INTO Aluta from other apps (screenshot /
                 gallery → Share → Aluta). receive_sharing_intent handles the
                 incoming intent; the app then shows a recipient picker. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
            </intent-filter>

            <!-- "Connected apps": tapping the Aluta "Voice call" / "Message" row
                 under a contact opens Aluta via ACTION_VIEW on these custom
                 mimetypes; MainActivity reads the row and routes the call/chat. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="vnd.android.cursor.item/vnd.com.ozilane.aluta.call" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="vnd.android.cursor.item/vnd.com.ozilane.aluta.message" />
            </intent-filter>
        </activity>

        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />

        <!-- Renderer: Impeller (Vulkan) is Flutter's default on Android and does
             NOT compile shaders at runtime — so it avoids the first-launch
             "Aluta isn't responding" jank that Skia causes on a fresh install.
             It was previously forced OFF because older engines lost the Vulkan
             context on Redmi / Xiaomi HyperOS ("citrine") GPUs and hard-aborted
             with "Check failed: back_texture. Context is valid:0"
             (flutter/impeller/display_list/canvas.cc).
             RE-ENABLED to test whether the current Flutter engine has fixed that
             crash on the Xiaomi test device. If it hard-aborts on launch, flip
             this back to "false" (Skia is stable there, at the cost of the
             one-time first-run shader-compile stall). -->
        <meta-data
            android:name="io.flutter.embedding.android.EnableImpeller"
            android:value="true" />

        <!-- FCM: the default channel a data/notification message is posted to if
             it doesn't name one. Matches the "Messages" channel created in
             notif_service.dart so background pushes ring on the right channel. -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="aluta_messages" />

        <!-- audio_service: media session (car / Bluetooth / lock-screen
             controls) + foreground playback service. -->
        <service
            android:name="com.ryanheise.audioservice.AudioService"
            android:foregroundServiceType="mediaPlayback"
            android:exported="true">
            <intent-filter>
                <action android:name="android.media.browse.MediaBrowserService" />
            </intent-filter>
        </service>

        <receiver
            android:name="com.ryanheise.audioservice.MediaButtonReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MEDIA_BUTTON" />
            </intent-filter>
        </receiver>

        <!-- Internal-audio capture for "identify song → from this phone".
             Foreground service of type mediaProjection (required Android 14+). -->
        <service
            android:name=".AudioCaptureService"
            android:exported="false"
            android:foregroundServiceType="mediaProjection" />

        <!-- Self-managed telecom ConnectionService: the platform binds this to
             create a system-visible connection per Aluta call, so a car /
             Bluetooth device can answer & hang up and route the call audio. -->
        <service
            android:name=".AlutaConnectionService"
            android:permission="android.permission.BIND_TELECOM_CONNECTION_SERVICE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.telecom.ConnectionService" />
            </intent-filter>
        </service>

        <!-- "Connected apps" account + sync source. The authenticator owns the
             stub "Aluta" account; the sync service attaches the custom contact
             rows (aluta_contacts.xml) so they render under matched contacts. -->
        <service
            android:name=".AuthenticatorService"
            android:exported="false">
            <intent-filter>
                <action android:name="android.accounts.AccountAuthenticator" />
            </intent-filter>
            <meta-data
                android:name="android.accounts.AccountAuthenticator"
                android:resource="@xml/aluta_authenticator" />
        </service>

        <service
            android:name=".AlutaContactsSyncService"
            android:exported="false">
            <intent-filter>
                <action android:name="android.content.SyncAdapter" />
            </intent-filter>
            <meta-data
                android:name="android.content.SyncAdapter"
                android:resource="@xml/aluta_syncadapter" />
            <meta-data
                android:name="android.provider.CONTACTS_STRUCTURE"
                android:resource="@xml/aluta_contacts" />
        </service>
    </application>

    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>

</manifest>
