# Copy to .env.txt for local dev, or set these as Railway service variables.
# Railway's Postgres plugin auto-provides DATABASE_URL — do not hardcode it there.
DATABASE_URL=postgresql://user:password@localhost:5432/my_aluta_db
SECRET_KEY=replace-with-a-64-char-hex-secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
INACTIVITY_TIMEOUT_MINUTES=60
ENVIRONMENT=production

# Aluta Admin (/admin) — owner account(s) allowed to use the admin panel
# (comma-separated Aluta emails), and a ONE-TIME setup code that enrolls the
# very first admin device. Remove ADMIN_BOOTSTRAP_CODE after first use.
ADMIN_OWNER_EMAILS=you@example.com
ADMIN_BOOTSTRAP_CODE=pick-a-long-random-code
PUBLIC_BASE_URL=https://aluta.ozilane.com
